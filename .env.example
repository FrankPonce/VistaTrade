# Copy to .env.local and fill in. All of these are SERVER-ONLY: never add a
# NEXT_PUBLIC_ prefix, or Next.js will ship the value to every browser.
#
# With no keys set, the app runs on simulated prices (clearly labelled in the UI).

# Alpaca (free "Basic" market data plan): prices, charts, symbol search.
# Create a free account at alpaca.markets, then Paper Trading > API Keys.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Finnhub (free): company profile, key stats, news.
FINNHUB_API_KEY=
